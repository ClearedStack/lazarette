{
  "rule": "GET or HEAD /v2/ answers 200, which tells a client this is an OCI registry. Other methods are refused.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v2/"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "3",
          "Content-Type": "application/json",
          "Docker-Distribution-Api-Version": "registry/2.0"
        },
        "body": "{}\n"
      }
    },
    {
      "request": {
        "method": "HEAD",
        "path": "/v2/"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "3",
          "Content-Type": "application/json",
          "Docker-Distribution-Api-Version": "registry/2.0"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v2"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "3",
          "Content-Type": "application/json",
          "Docker-Distribution-Api-Version": "registry/2.0"
        },
        "body": "{}\n"
      }
    },
    {
      "request": {
        "method": "DELETE",
        "path": "/v2/"
      },
      "response": {
        "status": 405,
        "headers": {
          "Allow": "GET, HEAD",
          "Content-Length": "133",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"UNSUPPORTED\",\"message\":\"this method is not handled on this endpoint\",\"detail\":{\"lazarette\":\"E_NEEDS_SUBTOOL\"}}]}\n"
      }
    }
  ]
}
