{
  "rule": "Manifests with a subject are indexed under /referrers/\u003cdigest\u003e, return OCI-Subject on commit, and support optional artifactType filtering.",
  "steps": [
    {
      "note": "referrers on an empty repository returns an empty OCI image index",
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/referrers/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "89",
          "Content-Type": "application/vnd.oci.image.index.v1+json"
        },
        "body": "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.index.v1+json\",\"manifests\":[]}\n"
      }
    },
    {
      "note": "setup: push config.json",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
        "bodyFile": "config.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
          "Location": "/v2/apps/example/blobs/sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de"
        }
      }
    },
    {
      "note": "setup: push layer.bin",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7",
        "bodyFile": "layer.bin"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7",
          "Location": "/v2/apps/example/blobs/sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7"
        }
      }
    },
    {
      "note": "setup: push sig.bin",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:0e70a452469375ec8df0c9d3ac470fec3a965a45faab87aedfc1da8cd2642e2c",
        "bodyFile": "sig.bin"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:0e70a452469375ec8df0c9d3ac470fec3a965a45faab87aedfc1da8cd2642e2c",
          "Location": "/v2/apps/example/blobs/sha256:0e70a452469375ec8df0c9d3ac470fec3a965a45faab87aedfc1da8cd2642e2c"
        }
      }
    },
    {
      "note": "subject manifest has not been pushed yet",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-referrer-sig.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "183",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_BLOB_UNKNOWN\",\"message\":\"manifest subject refers to a manifest that has not been pushed; the manifest was not stored\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
      "note": "push subject image manifest",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c",
          "Location": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
        }
      }
    },
    {
      "note": "push SBOM referrer",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-referrer-sbom.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f",
          "Location": "/v2/apps/example/manifests/sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f",
          "Oci-Subject": "sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
        }
      }
    },
    {
      "note": "push cosign bundle referrer",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-referrer-sig.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
          "Location": "/v2/apps/example/manifests/sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
          "Oci-Subject": "sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
        }
      }
    },
    {
      "note": "list all referrers in commit order",
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/referrers/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "570",
          "Content-Type": "application/vnd.oci.image.index.v1+json"
        },
        "body": "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.index.v1+json\",\"manifests\":[{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f\",\"size\":679,\"artifactType\":\"application/spdx+json\"},{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0\",\"size\":813,\"artifactType\":\"application/vnd.dev.sigstore.bundle.v0.3+json\",\"annotations\":{\"org.opencontainers.image.created\":\"2026-01-05T09:00:00Z\"}}]}\n"
      }
    },
    {
      "note": "filter referrers by artifactType",
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/referrers/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c?artifactType=application/vnd.dev.sigstore.bundle.v0.3%2Bjson"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "378",
          "Content-Type": "application/vnd.oci.image.index.v1+json",
          "Oci-Filters-Applied": "artifactType"
        },
        "body": "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.index.v1+json\",\"manifests\":[{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0\",\"size\":813,\"artifactType\":\"application/vnd.dev.sigstore.bundle.v0.3+json\",\"annotations\":{\"org.opencontainers.image.created\":\"2026-01-05T09:00:00Z\"}}]}\n"
      }
    },
    {
      "note": "unrecognised query parameter on referrers is refused",
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/referrers/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c?other=1"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "150",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"UNSUPPORTED\",\"message\":\"referrers query accepts at most one non-empty artifactType parameter\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    }
  ]
}
