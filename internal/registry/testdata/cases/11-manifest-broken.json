{
  "rule": "A manifest that is not well-formed is refused with E_PARSE: cut-off JSON, extra data after the JSON, a missing layers list, or a mediaType that disagrees with the Content-Type header.",
  "steps": [
    {
      "note": "setup: push config.json in one request",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
        "bodyFile": "config.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
          "Location": "/v2/apps/example/blobs/sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de"
        }
      }
    },
    {
      "note": "setup: push layer.bin in one request",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7",
        "bodyFile": "layer.bin"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7",
          "Location": "/v2/apps/example/blobs/sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:0564755e25f1f65dcd5b13732236dd4c44006b8f1ee16e3195196e63db876e3a",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-broken.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "135",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_INVALID\",\"message\":\"manifest is not a well-formed OCI image manifest\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:1fdc6e8dbaa922c4ad0e7b6b4041c68fae40f5d36af81cb5fe158c77863bf75c",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-trailing-data.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "135",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_INVALID\",\"message\":\"manifest is not a well-formed OCI image manifest\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:f280dfb2e7a3193cc8f448e976df41f588f7fc38e901651b0fa20c79f30578f5",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-no-layers.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "135",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_INVALID\",\"message\":\"manifest is not a well-formed OCI image manifest\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c",
        "headers": {
          "Content-Type": "application/vnd.docker.distribution.manifest.v2+json"
        },
        "bodyFile": "manifest.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "144",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_INVALID\",\"message\":\"manifest mediaType field and Content-Type header disagree\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/manifests/sha256:0564755e25f1f65dcd5b13732236dd4c44006b8f1ee16e3195196e63db876e3a"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Length": "88",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_UNKNOWN\",\"message\":\"manifest is not in this repository\"}]}\n"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Length": "88",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_UNKNOWN\",\"message\":\"manifest is not in this repository\"}]}\n"
      }
    }
  ]
}
