{
  "rule": "/digests/list returns up to 5 retained signed digests per app in oldest-to-newest order; unsigned images and non-signature referrers do not enter the list.",
  "steps": [
    {
      "note": "unknown repository answers 404 NAME_UNKNOWN",
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/digests/list"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Length": "73",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"NAME_UNKNOWN\",\"message\":\"repository is not known\"}]}\n"
      }
    },
    {
      "note": "setup: push config.json",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
        "bodyFile": "config.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
          "Location": "/v2/apps/example/blobs/sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de"
        }
      }
    },
    {
      "note": "setup: push layer.bin",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7",
        "bodyFile": "layer.bin"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7",
          "Location": "/v2/apps/example/blobs/sha256:5e930cbbf825c94c16e1bc9392c3cb32c38e07925d71cc7dea08d6e8745b5cb7"
        }
      }
    },
    {
      "note": "setup: push sig.bin",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:0e70a452469375ec8df0c9d3ac470fec3a965a45faab87aedfc1da8cd2642e2c",
        "bodyFile": "sig.bin"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:0e70a452469375ec8df0c9d3ac470fec3a965a45faab87aedfc1da8cd2642e2c",
          "Location": "/v2/apps/example/blobs/sha256:0e70a452469375ec8df0c9d3ac470fec3a965a45faab87aedfc1da8cd2642e2c"
        }
      }
    },
    {
      "note": "push unsigned image manifest",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c",
          "Location": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
        }
      }
    },
    {
      "note": "unsigned image is not in the retained signed digest list",
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/digests/list"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "37",
          "Content-Type": "application/json"
        },
        "body": "{\"name\":\"apps/example\",\"digests\":[]}\n"
      }
    },
    {
      "note": "attaching a non-signature SBOM referrer does not mark the image signed",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-referrer-sbom.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f",
          "Location": "/v2/apps/example/manifests/sha256:fe566c5f725ac413fc6fde3c0834bc761fe438c38cbdc4084235e5d6a0ae066f",
          "Oci-Subject": "sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/digests/list"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "37",
          "Content-Type": "application/json"
        },
        "body": "{\"name\":\"apps/example\",\"digests\":[]}\n"
      }
    },
    {
      "note": "attaching a cosign signature referrer marks the image signed",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest-referrer-sig.json"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Length": "0",
          "Docker-Content-Digest": "sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
          "Location": "/v2/apps/example/manifests/sha256:52cfc49bd5844c8c30503f6fd86786d3811e8ab0999aae054e9a8b8239e10bf0",
          "Oci-Subject": "sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v2/apps/example/digests/list"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Length": "110",
          "Content-Type": "application/json"
        },
        "body": "{\"name\":\"apps/example\",\"digests\":[\"sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c\"]}\n"
      }
    }
  ]
}
