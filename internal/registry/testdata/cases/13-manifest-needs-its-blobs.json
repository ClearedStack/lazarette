{
  "rule": "A manifest is stored only when its config and every layer are already stored at the sizes it states, so a half-finished push never leaves a manifest that can be pulled.",
  "steps": [
    {
      "note": "nothing pushed yet",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:c70503b35fd76637bf5fb5723feac32b1f8e5c6dbcea5b7009152d7ee6e17d2c",
        "headers": {
          "Content-Type": "application/vnd.oci.image.manifest.v1+json"
        },
        "bodyFile": "manifest.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "171",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_BLOB_UNKNOWN\",\"message\":\"manifest refers to a blob that has not been pushed; the manifest was not stored\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
