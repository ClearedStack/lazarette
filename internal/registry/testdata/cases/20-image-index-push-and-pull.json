          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_INVALID\",\"message\":\"image index gives a size or media type for a manifest that differs from the stored manifest; the index was not stored\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
