{
  "rule": "An OCI image index is stored by sha256 digest only when every child manifest is already stored in the same repository at the stated size and media type.",
  "steps": [
    {
      "note": "child manifest not pushed yet",
      "request": {
        "method": "PUT",
        "path": "/v2/apps/example/manifests/sha256:2530111c2bb389d0d60bcec8b24375523104cf9b881dae5c50ec2c38fed0fb8d",
        "headers": {
          "Content-Type": "application/vnd.oci.image.index.v1+json"
        },
        "bodyFile": "manifest-index-valid.json"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Length": "175",
          "Content-Type": "application/json"
        },
        "body": "{\"errors\":[{\"code\":\"MANIFEST_BLOB_UNKNOWN\",\"message\":\"image index refers to a manifest that has not been pushed; the index was not stored\",\"detail\":{\"lazarette\":\"E_PARSE\"}}]}\n"
      }
    },
    {
      "note": "setup: push config.json",
      "request": {
        "method": "POST",
        "path": "/v2/apps/example/blobs/uploads/?digest=sha256:9ee20c2128aa6883fce67605abbca5f2059f26ada628ee2cbbc0e9e7bdcdc4de",
